{
  "name": "sign-android-release",
  "version": "2.0.4",
  "private": true,
  "description": "GitHub action used to sign Android release packages",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --platform=node --outfile=index.js",
    "test": "jest",
    "deploy": "esbuild src/main.ts --bundle --minify --platform=node --outfile=index.js && ./update_release.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PuerNya/sign-android-release.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "PuerNya",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "jest": "^30.5.1",
    "jest-circus": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
